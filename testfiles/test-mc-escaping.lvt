\DocumentMetadata{tagging=on}
\input{regression-test}
\documentclass{article}

\begin{document}
\START
\ExplSyntaxOn

\TEST{mc-raw-lua-escaping}
 {
   \tl_clear:N \l__tag_mc_key_properties_tl
   \keys_set:nn { __tag / mc } { raw=/Alt~("Hello") }
   \ASSERTSTR{\l__tag_mc_key_properties_tl}{/Alt~("Hello")}
   \tl_clear:N \l__tag_mc_key_properties_tl
   \keys_set:nn { __tag / mc } { raw=/Alt~(Hello~\c_backslash_str (world\c_backslash_str )) }
   \ASSERTSTR{\l__tag_mc_key_properties_tl}{/Alt~(Hello~\c_backslash_str (world\c_backslash_str ))}
 }
\ExplSyntaxOff

\END
